{
  "name": "china-law-search",
  "productName": "中国法律检索",
  "version": "1.0.76",
  "description": "中国大陆法律法规本地检索与 AI 问答",
  "author": "DerekXuHQ",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "boot.mjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "data": "scripts/build-data.sh",
    "dist:mac": "scripts/build-mac.sh",
    "dist:mac:intel": "MAC_ARCH=x64 scripts/build-mac.sh",
    "dist:win": "scripts/build-win.sh",
    "upload-build-inputs": "gh release upload build-inputs --repo DerekXuHQ/claude-for-legal-china resources/base.db.gz resources/data-version.json --clobber",
    "agents": "node scripts/build-agents.mjs",
    "ios:web": "node ios/build-web.mjs",
    "ios:project": "node ios/build-web.mjs && cd ios && xcodegen generate",
    "ios:sim": "bash ios/run-sim.sh"
  },
  "dependencies": {
    "docx": "^9.15.2",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "openai": "7.50.0",
    "pdfjs-dist": "^5.7.284",
    "utif": "^3.1.0",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "buffer": "^6.0.3",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.10",
    "events": "^3.3.0",
    "fflate": "^0.8.2",
    "path-browserify": "^1.0.1",
    "stream-browserify": "^3.0.0",
    "util": "^0.12.5"
  },
  "build": {
    "appId": "com.derekxuhq.chinalawsearch",
    "productName": "中国法律检索",
    "copyright": "Apache-2.0",
    "files": [
      "boot.mjs",
      "shell/**",
      "main.mjs",
      "server/**",
      "renderer/**",
      "package.json",
      "node_modules/**"
    ],
    "extraResources": [
      {
        "from": "resources/base.db.gz",
        "to": "base.db.gz"
      },
      {
        "from": "resources/data-version.json",
        "to": "data-version.json"
      },
      {
        "from": "THIRD_PARTY.md",
        "to": "THIRD_PARTY.md"
      }
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.reference",
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "CFBundleDisplayName": "中国法律检索",
        "LSApplicationCategoryType": "public.app-category.reference",
        "NSMicrophoneUsageDescription": "语音输入时使用麦克风，把你说的话转成文字。"
      }
    },
    "dmg": {
      "title": "中国法律检索 ${version}",
      "artifactName": "ChinaLawSearch-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "legalTrademarks": "中国法律检索"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "中国法律检索",
      "artifactName": "ChinaLawSearch-${version}-win-${arch}-setup.${ext}",
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "deleteAppDataOnUninstall": false
    },
    "asarUnpack": [
      "server/**"
    ]
  },
  "updateSequence": 15,
  "depsId": "c9feb29bf264a6ca",
  "repository": {
    "type": "git",
    "url": "https://github.com/DerekXuHQ/claude-for-legal-china.git"
  }
}
